DATHOST_CONTROL_URL=https://api.example.com/matches/{matchId}/{action}
DATHOST_API_KEY=your_dathost_api_key_here

# --- Optional: direct DatHost server controls (used by the "Server" tab)
# Your DatHost server id (you can also type it in the UI)
DATHOST_SERVER_ID=
# API base (usually leave as default)
DATHOST_API_BASE=https://dathost.net
# If your account doesn't work with API keys for these endpoints, you can use Basic auth instead:
DATHOST_EMAIL=
DATHOST_PASSWORD=
# If your DatHost console endpoint differs, override it (either full URL or path):
# DATHOST_CONSOLE_PATH=/api/0.1/game-servers/{server_id}/console

ADMIN_SECRET=choose-a-server-only-secret
# For local testing only (do NOT use in production)
VITE_ADMIN_SECRET=choose-a-server-only-secret

# Optional: prefill the Server tab
VITE_DATHOST_SERVER_ID=
